# MindEcho Backend Environment Variables

# Application
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://mindecho:mindecho@localhost:5432/mindecho

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# AWS S3
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=mindecho-media
AWS_S3_ENDPOINT_URL=http://localhost:4566

# AWS Bedrock
AWS_BEDROCK_ENDPOINT_URL=http://localhost:4566
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
